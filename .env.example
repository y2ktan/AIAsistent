# PostgreSQL / pgvector
POSTGRES_USER=aegis_app
POSTGRES_PASSWORD=replace_with_strong_random_postgres_password
POSTGRES_DB=aegis_voice

# Go Backend Security & Bootstrap
# 32-byte hex (64 hex chars) or base64 key for AES-256-GCM secret vault
MASTER_ENCRYPTION_KEY=replace_with_64_hex_chars_aes256_key_00000000000000000000000000
# One-time token required to create the first admin when zero users exist
ADMIN_BOOTSTRAP_TOKEN=replace_with_one_time_bootstrap_token

# Server & Network
SERVER_PORT=8080
WEB_ORIGIN=http://localhost:3000
# Public HTTPS origin routed to the Go backend /api/v1/hosted-mcp/{id}.
# Required only for hosted MCP proxy mode; never derived from WEB_ORIGIN.
HOSTED_MCP_PROXY_BASE_URL=
COOKIE_SECURE=false
ALLOW_PRIVATE_AI_ENDPOINTS=false

# Pion WebRTC
ICE_UDP_MUX_PORT=8443
ICE_PUBLIC_IP=
STUN_URLS=stun:stun.l.google.com:19302

# Next.js BFF -> Go Backend internal URL
BACKEND_INTERNAL_URL=http://server:8080
NEXT_PUBLIC_APP_NAME=Aegis Voice
